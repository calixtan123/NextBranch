{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": { "NEXTBRANCH_RELEASE_BUILD": "1" }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "NEXTBRANCH_RELEASE_BUILD": "1",
        "EXPO_PUBLIC_NEXTBRANCH_TESTFLIGHT_WIDGET": "1",
        "EXPO_PUBLIC_NEXTBRANCH_MOCK_PLANS": "1"
      }
    }
  },
  "submit": { "production": {} }
}
